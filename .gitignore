# dotfiles-Windows :: repo .gitignore

# Machine-local layers — never commit
powershell/local.ps1
.gitconfig.local
# Local Claude Code state (settings.local.json, session history) stays out of the repo,
# but the committed routine command definitions under .claude/commands/ ARE tracked —
# the claude-routines.yml workflow runs them headless.
.claude/*
!.claude/commands/

# Secrets
*.pem
*.key
*.ppk
.env
.env.*

# Backups created by install.ps1
*.bak
*.*.bak

# Test artifacts - Pester's coverage gate writes coverage.xml into the repo root
# by default, so running the documented local gate (tests/CoverageGate.ps1) would
# otherwise leave an untracked report behind. CI runs in a fresh checkout and
# never commits it; this is purely so a local run stays clean.
coverage.xml

# OS cruft
Thumbs.db
Desktop.ini
