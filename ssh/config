# ~/.ssh/config  (Windows host — %USERPROFILE%\.ssh\config)
#
# NOTE: Windows OpenSSH does NOT support ControlMaster/ControlPath connection
# multiplexing the way the Fedora/Linux config does. Those lines are omitted
# here on purpose. Everything else mirrors the fleet's hardened defaults.
#
# Put real per-host secrets/keys in entries here or in a gitignored include.

Host *
    AddKeysToAgent yes
    IdentitiesOnly yes              # only offer keys named by IdentityFile, don't spray every agent key at each host
    ServerAliveInterval 60
    ServerAliveCountMax 3
    HashKnownHosts yes
    # Modern, hardened crypto (parity with the Linux repos)
    KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512
    Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes256-ctr
    MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com

# --- templates (copy + fill in) ----------------------------------------------
# Host github.com
#     HostName github.com
#     User git
#     IdentityFile ~/.ssh/id_ed25519

# Host bastion
#     HostName bastion.example.com
#     User youruser
#     IdentityFile ~/.ssh/id_ed25519

# Host lab
#     HostName 10.10.10.10
#     User operator
#     IdentityFile ~/.ssh/id_ed25519_lab

# Host vps
#     HostName your.vps.ip
#     User youruser
#     Port 22
#     IdentityFile ~/.ssh/id_ed25519

# --- WSL distros, from this host ---------------------------------------------
# Once OpenSSH Server is running here, the Windows sshd owns port 22 — so under
# networkingMode=mirrored a distro sshd that also wants 22 simply never binds.
# Each distro gets its own port instead (Port <n> in ITS /etc/ssh/sshd_config,
# which its own repo owns), and from this host it answers on loopback.
#
# `wsl-ssh-config` prints these blocks filled in for the distros you actually
# have — including the ProxyJump form for the machine you ssh FROM. See
# docs/REMOTE-ACCESS.md.
#
# Host kali
#     HostName 127.0.0.1
#     Port 2222
#     User youruser
#     IdentityFile ~/.ssh/id_ed25519
#     # A distro is reinstalled far more often than a server is rekeyed, and its
#     # host key changes with it — while the address (127.0.0.1:2222) does not.
#     # Keep those keys in their own file so a rebuild doesn't make you edit the
#     # known_hosts that protects everything else.
#     UserKnownHostsFile ~/.ssh/known_hosts.wsl

